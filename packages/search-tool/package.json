{
	"name": "search-tool",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test --experimental-strip-types tests/*.test.ts",
		"test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/search.ts --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=80 tests/*.test.ts"
	},
	"dependencies": {
		"@mixmark-io/domino": "^2.2.0",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1.0.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
