		"typebox": "1.3.7"
	},
	"bundleDependencies": [
		"shared"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1.0.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
