{
	"name": "agent-tool",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"compat": "node --experimental-strip-types scripts/compatibility-spike.ts",
		"test": "node --test --experimental-strip-types tests/*.test.ts",
		"test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=80 tests/*.test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
