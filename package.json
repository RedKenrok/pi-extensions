{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"ci": "npm run check && npm run compat && npm run test:payload",
		"compat": "npm run compat --workspace agent-tool",
		"lint": "npm run typecheck && biome check --write package.json tsconfig.json packages/codex-research-tool packages/fetch-tool packages/search-tool packages/agent-tool packages/compact-tool packages/codex-compaction",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"test:payload": "npm run test:payload --workspaces --if-present",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "24.5.2",
		"@types/turndown": "5.0.6",
		"typescript": "5.9.2"
	}
}
